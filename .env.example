# ============================================================
# Crypto Context Bot v4.0 — Configuration complète
# Paiements via Paddle (fonctionne depuis le Burkina Faso ✅)
# ============================================================
# 1. cp .env.example .env
# 2. Remplissez chaque valeur
# 3. Ne commitez JAMAIS votre .env sur Git
# ============================================================


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DISCORD — Obligatoire
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Token du bot Discord
# 1. https://discord.com/developers/applications
# 2. Votre application > onglet "Bot" > "Reset Token"
DISCORD_BOT_TOKEN=votre_token_discord_ici

BOT_NAME=CryptoContextBot

# Votre Discord User ID (pour les alertes admin)
# Discord > Paramètres > Avancé > Mode développeur > ON
# Clic droit sur votre pseudo > "Copier l'identifiant"
ADMIN_DISCORD_ID=votre_discord_user_id

# ID du canal pour recevoir les feedbacks (/feedback)
# Clic droit sur le canal > "Copier l'identifiant"
FEEDBACK_CHANNEL_ID=id_du_canal_feedback


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PADDLE — Paiements
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# URL de base de votre store Paddle
PADDLE_STORE_URL=https://buy.paddle.com

# Clé API Paddle
# Dashboard Paddle > Developer Tools > Authentication > New API key
PADDLE_API_KEY=votre_cle_api_paddle

# Secret de signature des webhooks
# Dashboard Paddle > Developer Tools > Notifications > votre endpoint > Secret key
PADDLE_WEBHOOK_SECRET=votre_secret_webhook_paddle

# Portail client Paddle (géré automatiquement par Paddle)
# Dashboard Paddle > Customer Portal
PADDLE_CUSTOMER_PORTAL=https://customer.paddle.com


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PADDLE — Payment Links (un par tier)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dashboard Paddle > Catalog > Products > votre produit > Payment Link
PADDLE_LINK_BASIC=https://buy.paddle.com/buy/votre_lien_basic
PADDLE_LINK_PRO=https://buy.paddle.com/buy/votre_lien_pro
PADDLE_LINK_PREMIUM=https://buy.paddle.com/buy/votre_lien_premium


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PADDLE — Price IDs (pour détecter les changements de plan)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dashboard Paddle > Catalog > Prices > copiez l'ID (format pri_xxxxxxxx)
PADDLE_PRICE_BASIC=pri_xxxxxxxxxxxxxxxxxx
PADDLE_PRICE_PRO=pri_xxxxxxxxxxxxxxxxxx
PADDLE_PRICE_PREMIUM=pri_xxxxxxxxxxxxxxxxxx


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WEBHOOK SERVER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REFERRAL — Programme de parrainage
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

REFERRAL_REWARD_MONTHS=1
REFERRAL_DISCOUNT_PCT=20


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BACKUPS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

MAX_LOCAL_BACKUPS=24

# S3 optionnel — laissez vide pour backups locaux uniquement
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=cryptobot/backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOGGING & ENVIRONNEMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
ENVIRONMENT=production
DEBUG=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MODE MANUEL (avant activation Paddle)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# true = mode manuel (contact Discord/email)
# false = mode automatique Paddle
MANUAL_MODE=true

# Votre pseudo Discord pour les contacts
CONTACT_DISCORD=@ton_pseudo_discord

# Email de contact
CONTACT_EMAIL=maresteph06@gmail.com

# Lien PayPal.me pour recevoir les paiements (optionnel)
# Créez le vôtre sur paypal.com/paypalme
PAYPAL_LINK=https://paypal.me/votre_lien
